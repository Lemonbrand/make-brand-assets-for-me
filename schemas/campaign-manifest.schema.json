{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lemonbrand/make-brand-assets-for-me/schemas/campaign-manifest.schema.json",
  "title": "Make Brand Assets For Me campaign manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "brand_id",
    "title",
    "launch_subject",
    "canonical_url",
    "cta",
    "utm",
    "source_facts",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "brand_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "launch_subject": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "pattern": "^https://"},
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "action"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "utm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "medium", "campaign"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "campaign": {"type": "string", "minLength": 1}
      }
    },
    "source_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "placement_id",
          "path",
          "width",
          "height",
          "format",
          "alt_text",
          "sha256",
          "claim_ids"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "placement_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "format": {"enum": ["png", "jpg", "jpeg", "gif", "pdf"]},
          "alt_text": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "page_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
