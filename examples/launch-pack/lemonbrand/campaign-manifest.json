    },
    {
      "id": "fact-six-skills",
      "text": "Version 0.2.2 contains six plain-language skills, including Make My Launch Pack, with deterministic portable typography.",
      "source_url": "https://github.com/Lemonbrand/make-brand-assets-for-me/releases/tag/v0.2.2"
    },
    {
      "id": "fact-self-proof",
      "text": "The launch-pack renderer in this repository generated the coordinated graphics used for this worked launch example.",
